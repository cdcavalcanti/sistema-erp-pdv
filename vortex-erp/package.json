{
  "name": "vortex-erp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP VORTEX — núcleo horizontal (cadastros, motor fiscal, estoque, vendas, compras, financeiro, contábil)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @vortex/api db:migrate",
    "db:seed": "pnpm --filter @vortex/api db:seed",
    "dev:api": "pnpm --filter @vortex/api dev",
    "dev:web": "pnpm --filter @vortex/web dev"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.15.30"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@fastify/static": "10.1.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}
