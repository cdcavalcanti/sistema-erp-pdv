# Copie para .env. Nunca coloque segredos reais no repositório.
NODE_ENV=development
PORT=3333

# Usuário dono (migrations) e usuário da aplicação (sujeito a RLS)
DATABASE_OWNER_URL=postgres://vortex_owner:vortex_owner@localhost:5432/vortex_erp
DATABASE_URL=postgres://vortex_app:vortex_app@localhost:5432/vortex_erp
WORKER_DATABASE_URL=postgres://vortex_worker:vortex_worker@localhost:5432/vortex_erp
TEST_DATABASE_OWNER_URL=postgres://vortex_owner:vortex_owner@localhost:5432/vortex_erp_test
TEST_DATABASE_URL=postgres://vortex_app:vortex_app@localhost:5432/vortex_erp_test
TEST_WORKER_DATABASE_URL=postgres://vortex_worker:vortex_worker@localhost:5432/vortex_erp_test

# Autenticação (stub local do VORTEX ID)
JWT_SECRET=troque-este-segredo-em-producao-com-32-bytes-ou-mais
JWT_TTL_SECONDS=28800
# Chave do console VORTEX para POST /v1/onboarding (obrigatória em produção, 32+ caracteres)
PROVISIONING_KEY=
# Token Bearer do GET /metrics (Prometheus). Sem ele, /metrics fica fechado em produção.
METRICS_TOKEN=

# Cofre de segredos (RN-ORG-04): chave mestra AES-256-GCM em base64 (32 bytes)
SECRETS_MASTER_KEY=ZGV2LWtleS1kZXYta2V5LWRldi1rZXktZGV2LWtleTE=

# Armazenamento imutável de XML (RN-NFE-08). Em produção: S3 com Object Lock.
STORAGE_DIR=./storage

# Gateway fiscal: simulated | partner
FISCAL_GATEWAY=simulated
FISCAL_PARTNER_URL=https://homologacao.parceiro-emissor.example/v2
FISCAL_PARTNER_TOKEN=
# Ambiente SEFAZ: 2 = homologação, 1 = produção (regra da casa: nunca testar emissão em produção)
SEFAZ_AMBIENTE=2

# Gateway bancário: simulated | partner
BANK_GATEWAY=simulated
WEBHOOK_SIGNING_SECRET=troque-este-segredo-de-webhook

# IA no ERP (seção 20). Sem chave a IA fica desligada e cada funcionalidade usa as regras.
# AI_PROVIDER=anthropic | none (padrão: anthropic quando há ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
# Alternativa à chave: token OAuth/gateway corporativo
# ANTHROPIC_AUTH_TOKEN=
AI_MODEL=claude-opus-5-5

# Tabelas oficiais (job semanal tabelas_oficiais.atualizar). Municípios vêm da API do IBGE;
# NCM, cClassTrib e CEST vêm de JSON publicado a partir do Portal NF-e/Siscomex. Vazio = não atualiza.
NCM_SOURCE_URL=
CCLASSTRIB_SOURCE_URL=
CEST_SOURCE_URL=

# Ferramentas de linha de comando
# MIGRATIONS_DIR=./apps/api/migrations   (padrão: localizado a partir do código)
# SEED_TENANT=demo                       (pnpm db:seed)
# SEED_PDV_ENV=../vortex-pdv/apps/pdv/.env  (pnpm db:seed: gera chave nova do terminal 03 e grava o .env do agente do PDV nesse caminho)
# SEED_HISTORY=0                         (pnpm db:seed: pula os 90 dias de operação fictícia; usado pelos testes ponta a ponta)
# SEED_HISTORY_DAYS=90                   (pnpm db:seed: quantos dias de histórico fictício gerar)

# Limites e logs da API
# RATE_LIMIT_MAX=600     requisições por minuto por token/chave (o seed usa um valor alto)
# LOG_LEVEL=debug        trace | debug | info | warn | error (produção: info)
