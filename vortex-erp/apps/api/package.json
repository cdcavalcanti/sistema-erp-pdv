{
  "name": "@vortex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "test": "vitest run",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset-cli.ts",
    "fiscal:import": "tsx --env-file-if-exists=../../.env src/modules/registry/official-import-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "6.1.2",
    "@vortex/contracts": "workspace:*",
    "@vortex/fiscal-engine": "workspace:*",
    "@vortex/money": "workspace:*",
    "@vortex/validators": "workspace:*",
    "fast-xml-parser": "^5.2.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "node-forge": "^1.3.1",
    "pg": "^8.16.0",
    "zod": "4.6.6",
    "@vortex/pricing": "workspace:*"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.11",
    "@types/pg": "^8.15.4",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.3"
  }
}
