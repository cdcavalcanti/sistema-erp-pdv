{
  "name": "vortex-pdv",
  "private": true,
  "version": "1.0.0",
  "description": "Vortex PDV — frente de caixa offline-first integrada ao Vortex ERP pela API",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @vortex/pdv dev",
    "dev:web": "pnpm --filter @vortex/pdv-web dev",
    "pair": "pnpm --filter @vortex/pdv pair",
    "e2e": "pnpm --filter @vortex/pdv-web e2e",
    "bateria": "node scripts/bateria-integrada.mjs",
    "release": "infra/release.sh"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.15.30"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@fastify/static": "10.1.6"
    }
  }
}
