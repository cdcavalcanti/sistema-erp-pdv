# Agente do terminal Vortex PDV. Copie para .env (ou deixe o seed/pareamento gerar).
# Nunca coloque chaves reais no repositório: .env está no .gitignore.
NODE_ENV=development

# API local consumida pela frente de caixa (sempre em 127.0.0.1)
PDV_PORT=4545
PDV_HOST=127.0.0.1
# Origem da interface em desenvolvimento (CORS). Em produção a interface é servida pelo próprio agente.
PDV_UI_ORIGIN=http://localhost:5174
# Pasta do build da interface (padrão: apps/pdv-web/dist)
# PDV_UI_DIR=
PDV_DB_PATH=./data/pdv.sqlite
# 32 bytes em base64 para cifrar dados sensíveis no banco local (CPF de clientes, chave do ERP).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção; em desenvolvimento há uma chave fixa de teste.
PDV_SECRET_KEY=

# ERP: endereço, chave de API do terminal (POST /v1/pdv/terminals devolve uma vez) e estabelecimento.
# Sem PDV_ERP_API_KEY, use o pareamento: pnpm --filter @vortex/pdv pair <chave>
PDV_ERP_URL=http://localhost:3333
PDV_ERP_API_KEY=
PDV_STORE_ID=
PDV_ERP_TIMEOUT_MS=8000
# Código do terminal no ERP (2 dígitos). É também a série da NFC-e deste caixa.
PDV_TERMINAL_CODE=01
PDV_APP_VERSION=1.0.0

# Sincronização (ms): carga do ERP e envio da fila, heartbeat do monitoramento e teto da espera entre tentativas
PDV_SYNC_INTERVAL_MS=30000
# Busca de alterações do ERP (preços, produtos, estoque, operadores); "Sincronizar agora" busca na hora
PDV_PULL_INTERVAL_MS=60000
PDV_HEARTBEAT_MS=60000
PDV_SYNC_MAX_BACKOFF_MS=600000
# Segredo HMAC dos webhooks do ERP (POST /api/webhooks/erp). Vazio desliga o recebimento.
PDV_WEBHOOK_SECRET=

# NFC-e: simulated (homologação simulada, identificada na tela) | partner (parceiro emissor)
PDV_FISCAL_PROVIDER=simulated
PDV_FISCAL_PARTNER_URL=
PDV_FISCAL_PARTNER_TOKEN=
# 2 = homologação (padrão), 1 = produção. Produção recusa qualquer integração simulada.
PDV_SEFAZ_AMBIENTE=2
# CSC da NFC-e (cadastrado na SEFAZ da UF)
PDV_NFCE_CSC_ID=000001
PDV_NFCE_CSC=

# Pagamentos
# Pix: simulated (PSP simulado) | psp (API Pix do Banco Central: /cob no PSP da loja)
PDV_PIX_PROVIDER=simulated
PDV_PIX_PSP_URL=
PDV_PIX_PSP_TOKEN=
# TEF integrado: simulated (pinpad simulado) | none (cartão só pela maquininha avulsa)
PDV_TEF_PROVIDER=simulated

# Impressora térmica ESC/POS: file (grava em PDV_PRINTER_SPOOL) | tcp (porta 9100) | none
PDV_PRINTER=file
PDV_PRINTER_HOST=127.0.0.1
PDV_PRINTER_PORT=9100
PDV_PRINTER_SPOOL=./data/spool

# Balança: simulated | tcp (protocolo Toledo por conversor serial-Ethernet ou ser2net) | none
PDV_SCALE=simulated
PDV_SCALE_HOST=127.0.0.1
PDV_SCALE_PORT=4001
